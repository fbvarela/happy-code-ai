# ── Neon Postgres ──────────────────────────────────────────
# Provided by Neon / Vercel integration. Already present in .env.local.
DATABASE_URL=

# ── Session (iron-session) ────────────────────────────────
# 64 hex chars / 32+ char random string.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── GitHub token encryption at rest (AES-256-GCM) ─────────
# Exactly 64 hex chars (32 bytes).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ── GitHub OAuth App ──────────────────────────────────────
# Create at https://github.com/settings/developers (OAuth App).
# Authorization callback URL (dev): http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: override the callback URL (defaults to <request-origin>/api/auth/github/callback)
# GITHUB_OAUTH_REDIRECT=

# ── LLM generator ─────────────────────────────────────────
# Provider is chosen by which key is set: Anthropic first (best), then Agnes 2.0
# (fast + cheap fallback). Set at least one to enable "Generar con IA".
ANTHROPIC_API_KEY=
# Optional override (default: claude-opus-4-8)
# GENERATOR_MODEL=

# Agnes 2.0 fallback (used when ANTHROPIC_API_KEY is empty).
# Get a key at https://platform.agnes-ai.com/
AGNES_API_KEY=
# Optional override (default: agnes-2.0-flash)
# AGNES_MODEL=
